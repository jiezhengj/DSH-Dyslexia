{
  "name": "@jiezhengj/dsh-dyslexia",
  "version": "0.2.9",
  "description": "Draws mermaid blocks right in the conversation and, when it helps, asks for a picture instead of a wall of text.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "mermaid",
    "diagram",
    "dyslexia",
    "accessibility"
  ],
  "type": "module",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiezhengj/DSH-Dyslexia.git"
  },
  "homepage": "https://github.com/jiezhengj/DSH-Dyslexia#readme",
  "bugs": {
    "url": "https://github.com/jiezhengj/DSH-Dyslexia/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "README*.md"
  ],
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "verify": "node verify/check-bundle.mjs",
    "harness": "node verify/run-harness.mjs",
    "test": "node verify/check-bundle.mjs && node verify/run-harness.mjs",
    "prepack": "node scripts/build-client.mjs && node verify/check-bundle.mjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  }
}
